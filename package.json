{
	"name": "about-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "node scripts/generate-llms-full.mjs && astro build",
		"build:all": "node scripts/generate-llms-full.mjs && astro build && cd lastfm-server && cargo build --release",
		"preview": "astro preview",
		"start": "concurrently \"astro preview\" \"cd lastfm-server && cargo run --release\"",
		"prepare": "echo ''",
		"check": "astro check",
		"check:watch": "astro check --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@astrojs/mdx": "^4",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@opentelemetry/api": "^1.9.1",
		"@tailwindcss/vite": "^4",
		"@types/node": "^20",
		"astro": "^5",
		"concurrently": "^9.2.1",
		"csstype": "^3.2.3",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.4.0",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"remark-footnotes": "^2.0.0",
		"tailwindcss": "^4",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1",
		"vite": "^7.1.7"
	},
	"dependencies": {
		"markdown-it": "^15.0.0",
		"markdown-it-footnote": "^4.0.0"
	}
}
