---
import '../app.css';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_TITLE, SITE_URL } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogType?: string;
	/** Optional per-page OG image override (path or absolute URL); defaults to /hero.webp. */
	ogImage?: string;
	/** Alt text for the OG image; defaults to the page title when a custom card is supplied. */
	ogImageAlt?: string;
}

const {
	title = SITE_TITLE,
	description = 'Writing on computer engineering, and other interests.',
	ogTitle,
	ogDescription,
	ogType = 'website',
	ogImage,
	ogImageAlt
} = Astro.props;

// `title` is the page's own name (e.g. "Writings"), used as-is for the
// breadcrumb. The tab/OG title composes the site name centrally so pages never
// bake it into their titles. A title equal to SITE_TITLE is the homepage and
// stays unsuffixed.
const tabTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
// Absolute page URL against the configured site domain — built with the URL
// constructor so the canonical/og values can never go relative or malformed.
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const canonicalTitle = ogTitle ?? tabTitle;
const canonicalDesc = ogDescription ?? description;
// An ogImage prop may itself be a relative path; the base URL turns it absolute.
const canonicalImage = new URL(ogImage ?? '/hero.webp', SITE_URL).href;
// Custom cards describe themselves via the page title; the shared hero keeps its painting alt.
const canonicalImageAlt = ogImage ? (ogImageAlt ?? `${canonicalTitle}`) : (ogImageAlt ?? 'Sketch of Landscape with Person on a Path by Anton Mauve');

const pathname = Astro.url.pathname;
const showBreadcrumbs = pathname !== '/';
const breadcrumbWidth = 'max-w-[600px]';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link
			rel="preload"
			href="/fonts/geist/geist-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/fonts/literata/literata-latin-opsz-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<title>{tabTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:title" content={canonicalTitle} />
		<meta property="og:description" content={canonicalDesc} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={canonicalImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={canonicalImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={canonicalTitle} />
		<meta name="twitter:description" content={canonicalDesc} />
		<meta name="twitter:image" content={canonicalImage} />
		<meta name="twitter:image:alt" content={canonicalImageAlt} />
		<link rel="describedby" type="text/plain" href="/llms.txt" />
		<script is:inline>
			(function () {
				var isDark = false;
				try {
					var theme = localStorage.getItem('theme');
					isDark = theme === 'dark';
					if (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches) {
						isDark = true;
					}
				} catch (e) {
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) isDark = true;
				}
				if (isDark) document.documentElement.classList.add('dark');
			})();
		</script>
		<slot name="head" />
	</head>
	<body>
		<a
			href="#main-content"
			class="fixed top-2 left-2 z-[999] -translate-y-20 rounded bg-ink px-4 py-2 font-sans text-[14px] text-bg no-underline transition-transform duration-200 focus:translate-y-0"
		>
			Skip to content
		</a>
		<div class="flex min-h-dvh flex-col bg-bg text-ink antialiased">
			{
				showBreadcrumbs && (
					<div class:list={['mx-auto w-[calc(100%-3rem)] pt-5', breadcrumbWidth]}>
						<Breadcrumbs pathname={pathname} title={title} />
					</div>
				)
			}
			<main id="main-content">
				<slot />
			</main>
		</div>
	</body>
</html>
