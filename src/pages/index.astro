---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { projects } from '../lib/projects-data';
import { indexMarkdown } from '../lib/markdown-helpers';
// @ts-ignore - used by the content-negotiation branch below
void indexMarkdown;

if (Astro.locals.prefersMarkdown) {
	return new Response(indexMarkdown(), {
		status: 200,
		headers: { 'Content-Type': 'text/markdown; charset=utf-8', Vary: 'Accept' }
	});
}

type RecentWriting = { id: string; title: string; date: string; snippet?: string };
const writings: RecentWriting[] = (await getCollection('writings'))
	.map((entry: CollectionEntry<'writings'>) => ({
		id: entry.id,
		title: entry.data.title,
		date: entry.data.date,
		snippet: entry.data.snippet
	}))
	.sort(
		(a: RecentWriting, b: RecentWriting) => new Date(b.date).getTime() - new Date(a.date).getTime()
	)
	.slice(0, 5);
const recentProjects = projects.slice(0, 5);
const navigation = [
	{ href: '/writings', label: 'Writings' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/photography', label: 'Photography' },
	{ href: '/art', label: 'Art' },
	{ href: '/about', label: 'About' },
	{ href: '/current', label: 'Right now' },
	{ href: '/contact', label: 'Contact' },
	{ href: 'https://github.com/KIRKR101', label: 'GitHub', external: true }
];
const formatDate = (date: string) =>
	new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).format(
		new Date(date)
	);
---

<Layout title="kirkr.xyz" description="Writing on computer engineering, and other interests.">
	<div class="relative flex min-h-dvh flex-col items-center justify-center px-6 py-8 md:py-16">
		<main class="relative z-10 w-full max-w-[600px]">
			<section class="pb-8">
				<p class="max-w-none font-sans text-[14px] leading-[1.8] text-ink-80 sm:text-[16px]">
					I am a first year CompE student at Warwick. I enjoy C and TypeScript, and web tech more
					generally; this site is built on Astro. I am also interested in politics, philosophy,
					economics, photography, and art — particularly Dutch.
				</p>
				<div class="mt-7">
					<nav
						class="grid grid-cols-2 gap-px border border-bd bg-bd font-sans text-[13px] text-ink-80 sm:grid-cols-4"
						aria-label="Main navigation"
					>
						{
							navigation.map((link) => (
								<a
									href={link.href}
									{...(link.external && { target: '_blank', rel: 'noopener noreferrer' })}
									class="flex min-w-0 flex-wrap items-center justify-start gap-2 bg-bg px-3 py-2.5 text-left transition-colors hover:text-ink hover:underline"
								>
									<svg
										width="14"
										height="14"
										viewBox="0 0 16 16"
										fill="none"
										xmlns="http://www.w3.org/2000/svg"
										aria-hidden="true"
										class="text-ink-30"
									>
										<path
											d="M12 10V4m0 0H6m6 0l-7.833 7.833"
											stroke="currentColor"
											stroke-width="1"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									<span class="min-w-0 break-words">{link.label}</span>
								</a>
							))
						}
					</nav>
				</div>
			</section>

			<section class="cv-auto py-4">
				<div class="mb-1 flex items-baseline justify-between border-b border-bd/80 pb-1 sm:px-1.5">
					<div class="font-serif text-[24px] text-ink-90">Writings</div>
					<a
						href="/writings"
						class="group mt-4 inline-flex cursor-pointer items-center gap-1.5 self-start font-mono text-[11px] tracking-wider text-ink-70 uppercase transition-colors duration-150 hover:text-ink"
					>
						[+]
					</a>
				</div>
				<div class="flex flex-col">
					{
						writings.map((writing) => (
							<a
								href={`/writing/${writing.id}`}
								class="group flex w-full flex-col rounded-sm border-b border-bd/40 py-2.5 no-underline transition-colors duration-100 ease-out last:border-0 hover:bg-ink/2 hover:duration-0 sm:px-1.5"
							>
								<div class="flex w-full items-baseline justify-between gap-4">
									<div class="min-w-0 sm:flex sm:items-baseline">
										<span class="font-sans text-[14px] text-ink-80 transition-colors duration-100 group-hover:text-ink hover:underline hover:decoration-ink/70 hover:underline-offset-2">
											{writing.title}
										</span>
										{writing.snippet && (
											<>
												<span class="mx-1.5 hidden text-ink-50 sm:inline">—</span>
												<span class="hidden truncate font-sans text-[13px] text-ink-70 sm:inline">
													{writing.snippet}
												</span>
											</>
										)}
									</div>
									<span class="shrink-0 font-mono text-[11px] tracking-wider text-ink-70 uppercase">
										{formatDate(writing.date)}
									</span>
								</div>
								{writing.snippet && (
									<span class="mt-1 line-clamp-2 font-sans text-[12px] leading-relaxed text-ink-70 sm:hidden">
										{writing.snippet}
									</span>
								)}
							</a>
						))
					}
				</div>
			</section>

			<section class="cv-auto pt-4 pb-2">
				<div class="mb-1 flex items-baseline justify-between border-b border-bd/80 pb-1 sm:px-1.5">
					<div class="font-serif text-[24px] text-ink-90">Projects</div>
					<a
						href="/projects"
						class="group mt-4 inline-flex cursor-pointer items-center gap-1.5 self-start font-mono text-[11px] tracking-wider text-ink-70 uppercase transition-colors duration-150 hover:text-ink"
					>
						[+]
					</a>
				</div>
				<div class="flex flex-col">
					{
						recentProjects.map((project) => (
							<a
								href={`/project/${project.id}`}
								class="group flex w-full flex-col rounded-sm border-b border-bd/40 py-2.5 no-underline transition-colors duration-100 ease-out last:border-0 hover:bg-ink/2 hover:duration-0 sm:px-1.5"
							>
								<div class="flex w-full items-baseline justify-between gap-4">
									<div class="min-w-0 sm:flex sm:items-baseline">
										<span class="font-sans text-[14px] text-ink-80 transition-colors duration-100 group-hover:text-ink hover:underline hover:decoration-ink/70 hover:underline-offset-2">
											{project.title}
										</span>
										{project.shortDescription && (
											<>
												<span class="mx-1.5 hidden text-ink-50 sm:inline">—</span>
												<span class="hidden truncate font-sans text-[13px] text-ink-70 sm:inline">
													{project.shortDescription}
												</span>
											</>
										)}
									</div>
									<span class="shrink-0 font-mono text-[11px] tracking-wider text-ink-70 uppercase">
										{project.firstCommit}
									</span>
								</div>
								{project.shortDescription && (
									<span class="mt-2 line-clamp-2 font-sans text-[12px] leading-relaxed text-ink-70 sm:hidden">
										{project.shortDescription}
									</span>
								)}
							</a>
						))
					}
				</div>
			</section>

			<Footer />
		</main>
	</div>
</Layout>
