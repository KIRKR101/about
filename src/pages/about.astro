---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="About | kirkr.xyz" description="About this site and its author."><div class="flex min-h-[calc(100dvh-4rem)] flex-col items-center px-6 py-6 md:py-16"><main class="w-full max-w-[600px]"><div class="py-4"><h1 class="font-serif text-[48px] leading-tight text-ink">About<span class="opacity-40">.</span></h1></div><div class="mb-8 h-px bg-bd"></div><p class="font-sans text-[15px] leading-[1.8] text-ink-80">I’m a computer engineering student at Warwick. This is my part of the internet for writing, software projects, photography, and art.</p><p class="mt-5 font-sans text-[15px] leading-[1.8] text-ink-80">The site is built with Astro and is a place to keep notes, collect things I like, and share what I’m working on.</p><Footer /></main></div></Layout>
