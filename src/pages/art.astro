---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { artMarkdown } from '../lib/markdown-helpers';
import { getArtGroups, artGroupSlug, artThumbnail, getArtGroupThumbnail } from '../lib/art-groups';
// Keep the markdown representation available to content-negotiating clients.
void artMarkdown;

const groups = getArtGroups();
if (Astro.locals.prefersMarkdown)
	return new Response(
		artMarkdown(
			groups.flatMap((group) =>
				group.entries.map(([id, artwork]) => ({
					id,
					title: artwork.title,
					description: artwork.description,
					data: artwork.data
				}))
			)
		),
		{ status: 200, headers: { 'Content-Type': 'text/markdown; charset=utf-8', Vary: 'Accept' } }
	);
---

<Layout title="Art | kirkr.xyz" description="Artworks I like.">
	<div class="flex min-h-[calc(100dvh-4rem)] flex-col items-center px-6 py-6 md:py-16">
		<main class="w-full max-w-[600px]">
			<div class="py-4">
				<h1 class="font-serif text-[48px] leading-tight tracking-[-1px] text-ink">
					Art<span class="opacity-40">.</span>
				</h1>
			</div>
			<div class="mb-10 h-px bg-bd"></div>
			<div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-2">
				{
					groups.map(({ name, entries }) => {
						const thumbnail = getArtGroupThumbnail(name, entries);
						return (
							<a href={`/art/${artGroupSlug(name)}`} class="group no-underline">
								<>
									<div class="aspect-[3/4] overflow-hidden rounded-sm border border-bd bg-card-bg">
										<img
											src={artThumbnail(thumbnail)}
											alt={name}
											class="h-full w-full object-cover"
											loading="lazy"
										/>
									</div>
									<div class="mt-3 font-serif text-[25px] text-ink-90 group-hover:underline group-hover:underline-offset-4">
										{name}
									</div>
									<div class="mt-1 font-mono text-[10px] tracking-wider text-ink-50 uppercase">
										{entries.length} works
									</div>
								</>
							</a>
						);
					})
				}
			</div>
			<Footer />
		</main>
	</div>
</Layout>
