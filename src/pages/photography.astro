---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { photographyData } from '../lib/photography-list';
import { photographyMarkdown } from '../lib/markdown-helpers';
void photographyMarkdown;

const cities = Object.entries(photographyData).map(([name, images]) => ({
	name,
	image: images[0],
	count: images.length
}));
const slugify = (value: string) => value.toLowerCase().replace(/\s+/g, '-');

if (Astro.locals.prefersMarkdown) {
	return new Response(photographyMarkdown(cities.map((city) => city.name)), {
		status: 200,
		headers: { 'Content-Type': 'text/markdown; charset=utf-8', Vary: 'Accept' }
	});
}
---

<Layout
	title="Photography | kirkr.xyz"
	description="A collection of photography from various cities."
>
	<div class="flex min-h-[calc(100dvh-4rem)] flex-col items-center px-6 py-6 md:py-16">
		<main class="w-full max-w-[600px]">
			<div class="py-4">
				<h1 class="font-serif text-[48px] leading-tight tracking-[-1px] text-ink">
					Photography<span class="opacity-40">.</span>
				</h1>
			</div>
			<div class="mb-10 h-px bg-bd"></div>
			<div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-2">
				{
					cities.map(
						({ name, image, count }) =>
							image && (
								<a href={`/photography/${slugify(name)}`} class="group no-underline">
									<div class="aspect-[3/4] overflow-hidden rounded-sm border border-bd bg-card-bg">
										<img
											src={image.url}
											srcset={image.srcset}
											sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
											alt={`Photography from ${name}`}
											class="h-full w-full object-cover"
											loading="lazy"
										/>
									</div>
									<div class="mt-3 font-serif text-[25px] text-ink-90 group-hover:underline group-hover:underline-offset-4">
										{name}
									</div>
									<div class="mt-1 font-mono text-[10px] tracking-wider text-ink-50 uppercase">
										{count} photographs
									</div>
								</a>
							)
					)
				}
			</div>
			<Footer />
		</main>
	</div>
</Layout>
