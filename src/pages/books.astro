---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { booksMarkdown } from '../lib/markdown-helpers';
// @ts-ignore - false positive
void booksMarkdown;

if (Astro.locals.prefersMarkdown) {
	return new Response(booksMarkdown(), {
		status: 200,
		headers: {
			'Content-Type': 'text/markdown; charset=utf-8',
			Vary: 'Accept'
		}
	});
}
---

<Layout title="Books | kirkr.xyz" description="A log of books currently reading and previously read.">
	<Navbar slot="navbar" />
	<link rel="preconnect" href="https://hardcover.kirkr.xyz" crossorigin="anonymous" slot="head" />

	<div class="flex min-h-[calc(100dvh-4rem)] flex-col items-center px-6 py-6 md:py-16">
		<main class="w-full max-w-[600px]">
			<div class="py-4">
				<h1 class="font-serif text-[48px] leading-tight tracking-[-1px] text-ink">
					<span class="opacity-90">Books</span><span class="opacity-40">.</span>
				</h1>
			</div>

			<div class="mb-8 h-px bg-bd"></div>

			<div data-books-loading class="py-8 text-center">
				<div class="font-mono text-[11px] tracking-[0.1em] text-ink-70 uppercase">
					Loading books...
				</div>
			</div>

			<div data-books-error class="hidden rounded-sm border border-bd bg-ink/5 py-8 text-center">
				<div class="font-mono text-[11px] tracking-[0.1em] text-ink-70 uppercase">
					Failed to load books
				</div>
			</div>

			<div data-books-content class="hidden">
				<div data-currently-reading class="mb-6 hidden">
					<div class="mb-6 font-sans text-[11px] tracking-[0.1em] text-ink-70 uppercase">
						Currently Reading
					</div>
					<div data-currently-list class="space-y-6"></div>
				</div>

				<div data-previously-read class="mb-6 hidden">
					<div class="mb-6 font-sans text-[11px] tracking-[0.1em] text-ink-70 uppercase">
						Previously Read
					</div>
					<div data-previously-list class="space-y-6"></div>
				</div>

				<div class="mt-8 font-mono text-[11px] text-ink-70">data since 25/06/2026</div>
			</div>

			<Footer />
		</main>
	</div>
</Layout>

<script>
	const CACHE_TTL = 2 * 60 * 60 * 1000;

	function getHardcoverSrcset(coverUrl: string): string {
		if (!coverUrl) return '';
		const base = 'https://production-img.hardcover.app/enlarge';
		const widths = [150, 270, 400];
		return widths
			.map((w) => {
				const h = Math.round(w * 1.5);
				const params = new URLSearchParams({
					width: String(w),
					height: String(h),
					type: 'webp',
					url: coverUrl,
				});
				return `${base}?${params} ${w}w`;
			})
			.join(', ');
	}

	function createStarRating(rating: number | null) {
		if (rating === null || rating === undefined) return '';
		const fullStars = Math.floor(rating);
		const hasHalfStar = rating % 1 !== 0;
		let starsHtml = '★'.repeat(fullStars);
		if (hasHalfStar) starsHtml += '½';
		return starsHtml;
	}

	function formatDate(dateStr: string | undefined) {
		if (!dateStr) return 'N/A';
		return new Date(dateStr).toLocaleDateString(undefined, {
			timeZone: 'Europe/London',
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		});
	}

	function formatDateTime(dateStr: string | undefined) {
		if (!dateStr) return 'N/A';
		return new Date(dateStr).toLocaleString(undefined, {
			timeZone: 'Europe/London',
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			hour: '2-digit',
			minute: '2-digit',
		});
	}

	function loadCachedBooks() {
		try {
			const stored = localStorage.getItem('books-cache');
			if (!stored) return null;
			const parsed = JSON.parse(stored);
			if (
				parsed &&
				typeof parsed.timestamp === 'number' &&
				Array.isArray(parsed.currentlyReading) &&
				Array.isArray(parsed.previouslyRead)
			) {
				if (Date.now() - parsed.timestamp > CACHE_TTL) {
					localStorage.removeItem('books-cache');
					return null;
				}
				return {
					currentlyReading: parsed.currentlyReading,
					previouslyRead: parsed.previouslyRead,
				};
			}
			return null;
		} catch {
			return null;
		}
	}

	function saveCachedBooks(currentlyReading: any[], previouslyRead: any[]) {
		try {
			localStorage.setItem(
				'books-cache',
				JSON.stringify({ currentlyReading, previouslyRead, timestamp: Date.now() }),
			);
		} catch (e) {
			console.warn('Failed to cache books:', e);
		}
	}

	function escapeHtml(str: string): string {
		return str.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
	}

	function renderBooks(currentlyReading: any[], previouslyRead: any[]) {
		const loading = document.querySelector('[data-books-loading]') as HTMLElement | null;
		const error = document.querySelector('[data-books-error]') as HTMLElement | null;
		const content = document.querySelector('[data-books-content]') as HTMLElement | null;
		const currSection = document.querySelector('[data-currently-reading]') as HTMLElement | null;
		const prevSection = document.querySelector('[data-previously-read]') as HTMLElement | null;
		const currList = document.querySelector('[data-currently-list]') as HTMLElement | null;
		const prevList = document.querySelector('[data-previously-list]') as HTMLElement | null;

		if (loading) loading.classList.add('hidden');
		if (error) error.classList.add('hidden');
		if (content) content.classList.remove('hidden');

		if (currSection && currList) {
			if (currentlyReading.length > 0) {
				currSection.classList.remove('hidden');
				currList.innerHTML = currentlyReading
					.map(
						(item: any) => `
					<div class="flex gap-4 border-b border-bd pb-6">
						<div class="relative flex h-48 w-32 flex-shrink-0 items-center justify-center overflow-hidden rounded-sm border border-bd bg-card-bg text-ink-20">
							<span class="-rotate-[315deg] text-center font-serif text-[13px] leading-tight tracking-wide select-none" aria-hidden="true">
								${escapeHtml(item.book.title)}
							</span>
							<img
								src="${item.book.cover_url}"
								srcset="${getHardcoverSrcset(item.book.cover_url)}"
								sizes="128px"
								alt="${escapeHtml(item.book.title)}"
								class="absolute inset-0 h-full w-full rounded-sm object-cover"
								loading="lazy"
								onerror="this.style.opacity='0'"
							/>
						</div>
						<div class="flex flex-1 flex-col justify-center">
							<div class="font-serif text-[20px] leading-tight text-ink-90">
								<a
									href="https://hardcover.app/books/${item.book.slug}?referrer_id=120657"
									target="_blank"
									rel="noopener noreferrer"
									class="text-inherit no-underline transition-colors duration-75 hover:text-ink-80"
								>
									${escapeHtml(item.book.title)}
								</a>
							</div>
							<div class="mt-1 font-mono text-[11px] tracking-wider text-ink-70">
								by ${escapeHtml(item.book.authors[0] ?? 'Unknown author')}, ${item.book.release_year}
							</div>
							${
								item.progress
									? `<div class="mt-3">
								<div class="h-[3px] w-full overflow-hidden rounded-full bg-rail">
									<div class="h-full rounded-full bg-prog transition-all duration-300" style="width: ${item.progress.percentage}%"></div>
								</div>
								<div class="mt-3 flex items-center gap-1.5 font-mono text-[11px] tracking-wider text-ink-70">
									<span>${item.progress.pages_read} / ${item.progress.total_pages} pages</span>
								</div>
							</div>`
									: ''
							}
							<div class="mt-2 font-mono text-[11px] tracking-wider text-ink-70">
								Started: ${formatDate(item.user_book.started_reading)}
								${item.last_read_event ? `&middot; Last read: ${formatDateTime(item.last_read_event.action_at)}` : ''}
							</div>
						</div>
					</div>
				`,
					)
					.join('');
			} else {
				currSection.classList.add('hidden');
			}
		}

		if (prevSection && prevList) {
			if (previouslyRead.length > 0) {
				prevSection.classList.remove('hidden');
				prevList.innerHTML = previouslyRead
					.map(
						(item: any) => `
					<div class="flex gap-4 border-b border-bd pb-6 last:border-0">
						<div class="relative flex h-48 w-32 flex-shrink-0 items-center justify-center overflow-hidden rounded-sm border border-bd bg-card-bg text-ink-20">
							<span class="-rotate-[315deg] text-center font-serif text-[13px] leading-tight tracking-wide select-none" aria-hidden="true">
								${escapeHtml(item.book.title)}
							</span>
							<img
								src="${item.book.cover_url}"
								srcset="${getHardcoverSrcset(item.book.cover_url)}"
								sizes="128px"
								alt="${escapeHtml(item.book.title)}"
								class="absolute inset-0 h-full w-full rounded-sm object-cover"
								loading="lazy"
								onerror="this.style.opacity='0'"
							/>
						</div>
						<div class="flex flex-col justify-center">
							<div class="font-serif text-[20px] leading-tight text-ink-90">
								<a
									href="https://hardcover.app/books/${item.book.slug}?referrer_id=120657"
									target="_blank"
									rel="noopener noreferrer"
									class="text-inherit no-underline transition-colors duration-75 hover:text-ink-80"
								>
									${escapeHtml(item.book.title)}
								</a>
							</div>
							<div class="mt-1 font-mono text-[11px] tracking-wider text-ink-70">
								by ${escapeHtml(item.book.authors[0] ?? 'Unknown author')} &middot; ${item.book.release_year}
							</div>
							<div class="mt-2 font-mono text-[11px] tracking-wider text-ink-70">
								${item.user_book.rating ? `<span class="text-[15px] text-ink-50">${createStarRating(item.user_book.rating)}</span><span class="text-bd">&middot;</span>` : ''}
								<span>Finished: ${formatDate(item.user_book.last_read_date)}</span>
							</div>
						</div>
					</div>
				`,
					)
					.join('');
			} else {
				prevSection.classList.add('hidden');
			}
		}
	}

	async function fetchBooks() {
		const cached = loadCachedBooks();
		if (cached) {
			renderBooks(cached.currentlyReading, cached.previouslyRead);
			return;
		}

		try {
			const apiUrl = 'https://hardcover.kirkr.xyz';
			const response = await fetch(apiUrl);
			if (!response.ok) throw new Error(`Status ${response.status}`);
			const data = await response.json();
			const currentlyReading = data.currently_reading || [];
			const previouslyRead = data.previously_read || [];
			saveCachedBooks(currentlyReading, previouslyRead);
			renderBooks(currentlyReading, previouslyRead);
		} catch {
			const loading = document.querySelector('[data-books-loading]') as HTMLElement | null;
			const error = document.querySelector('[data-books-error]') as HTMLElement | null;
			if (loading) loading.classList.add('hidden');
			if (error) error.classList.remove('hidden');
		}
	}

	fetchBooks();
</script>
