---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { preprocessMarkdown, renderMarkdown } from '../../scripts/render-markdown';

export const prerender = false;

let entry = (Astro.props as { entry?: CollectionEntry<'projects'> }).entry;
if (!entry) {
	const slug = (Astro.params as { slug?: string }).slug;
	if (slug) {
		const projects = await getCollection('projects');
		entry = projects.find((e: CollectionEntry<'projects'>) => e.id === slug);
	}
}
if (!entry) {
	return Astro.redirect('/404');
}

if (Astro.locals.prefersMarkdown) {
	return new Response(entry.body ?? '', {
		status: 200,
		headers: {
			'Content-Type': 'text/markdown; charset=utf-8',
			Vary: 'Accept'
		}
	});
}

let title = entry.data.title;
let description = entry.data.description;
let github = entry.data.github ?? '';
let htmlContent = '';

const preprocessed = preprocessMarkdown(entry.body ?? '');
htmlContent = renderMarkdown(preprocessed);
// Prepend TL;DR description (mirrors ProjectLayout.svelte) — escape to match Svelte auto-escaping
function esc(s: string) {
	return s
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;')
		.replace(/'/g, '&#39;');
}
htmlContent = `<p>TL;DR: ${esc(description)}</p>\n` + htmlContent;
const notFound = false;
---

{
	notFound ? (
		<Layout title={`Not found`}>
			<div class="flex min-h-full flex-col items-center justify-start px-6 pt-[20vh] pb-6 lg:pt-[24vh] lg:pb-16">
				<main class="w-full max-w-[600px] pl-6 md:pl-10">
					<div class="font-sans text-[11px] tracking-[0.1em] text-ink-70 uppercase">Error 404</div>
					<div class="mt-3 font-serif text-[26px] leading-tight text-ink-90">Page not found</div>
					<p class="mt-4 font-sans text-[14px] leading-[1.7] text-ink-70">
						The page you're looking for doesn't exist or has been moved.
					</p>
					<a
						href="/"
						class="group mt-8 inline-flex cursor-pointer items-center gap-1.5 font-sans text-[13px] font-medium text-ink-70 no-underline transition-colors duration-150 hover:text-ink"
					>
						<svg
							width="12"
							height="12"
							viewBox="0 0 256 256"
							fill="currentColor"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
							class="text-ink-70 transition-colors duration-150 group-hover:text-ink"
						>
							<path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z" />
						</svg>
						Return home
					</a>
				</main>
			</div>
		</Layout>
	) : (
		<Layout title={`${title}`} description={description || title}>
			<div class="flex min-h-0 flex-col items-center px-6 py-6 font-sans md:py-16">
				<main class="w-full max-w-[600px]">
					<div class="py-4">
						<h1 class="font-serif text-[42px] leading-tight tracking-[-1px] text-ink">{title}</h1>

						<div class="mt-3 flex items-center font-mono text-[11px] tracking-[0.1em] text-ink-70 uppercase">
							<a
								href={github}
								class="inline-flex items-center gap-2 text-ink-70 underline decoration-ink/55 underline-offset-2 transition-colors duration-75 hover:text-ink hover:decoration-ink"
							>
								<svg
									role="img"
									viewBox="0 0 24 24"
									width="16"
									height="16"
									fill="currentColor"
									xmlns="http://www.w3.org/2000/svg"
								>
									<title>GitHub</title>
									<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
								</svg>
								<span>View on GitHub</span>
							</a>

							<span data-last-commit data-github={github} class="ml-auto hidden" />
						</div>
					</div>

					<div class="mb-8 h-px bg-bd" />

					<article data-project-article class="prose max-w-none" set:html={htmlContent} />

					{/* Lightbox for carousel images (shared overlay; JS toggles data-open) */}
					<div
						data-carousel-lightbox
						class="ease-out-soft invisible fixed inset-0 z-60 flex scale-[0.98] bg-[#0b0b0b]/95 opacity-0 transition-[opacity,visibility,scale] duration-200 outline-none select-none data-[open]:visible data-[open]:scale-100 data-[open]:opacity-100 motion-reduce:transition-none"
						role="dialog"
						aria-modal="true"
						tabindex="-1"
					>
						<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.04),transparent_60%)]" />
						<button
							type="button"
							data-carousel-lb-close
							class="absolute top-4 right-4 z-50 flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/5 text-white transition-[background-color,opacity,scale] duration-200 ease-out hover:bg-white/10 focus-visible:outline-white/60 active:scale-95 md:top-6 md:right-6 md:h-11 md:w-11"
							aria-label="Close lightbox"
						>
							<svg
								class="h-5 w-5"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
							>
								<path d="M18 6L6 18M6 6l12 12" />
							</svg>
						</button>
						<button
							type="button"
							data-carousel-lb-prev
							class="absolute top-1/2 left-3 z-50 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/5 text-white transition-[background-color,opacity,scale] duration-200 ease-out hover:bg-white/10 focus-visible:outline-white/60 active:scale-95 md:left-6 md:h-14 md:w-14"
							aria-label="Previous image"
						>
							<svg
								class="h-5 w-5 md:h-6 md:w-6"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
							>
								<path d="M15 18l-6-6 6-6" />
							</svg>
						</button>
						<button
							type="button"
							data-carousel-lb-next
							class="absolute top-1/2 right-3 z-50 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/5 text-white transition-[background-color,opacity,scale] duration-200 ease-out hover:bg-white/10 focus-visible:outline-white/60 active:scale-95 md:right-6 md:h-14 md:w-14"
							aria-label="Next image"
						>
							<svg
								class="h-5 w-5 md:h-6 md:w-6"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
							>
								<path d="M9 18l6-6-6-6" />
							</svg>
						</button>
						<div class="absolute inset-x-1 top-2 bottom-2 flex [touch-action:pinch-zoom] items-center justify-center">
							<img
								data-carousel-lb-image
								src=""
								alt=""
								class="max-h-full max-w-full object-contain transition-opacity duration-200 ease-out motion-reduce:transition-none"
								draggable="false"
							/>
						</div>
						<div class="pointer-events-none absolute right-0 bottom-0 left-0 bg-gradient-to-t from-black/80 via-black/60 to-transparent px-4 pt-20 pb-6 md:px-6 md:pt-28 md:pb-8">
							<div class="mx-auto w-full max-w-[780px] text-center">
								<div
									data-carousel-lb-title
									class="font-serif text-[22px] leading-tight tracking-tight text-white/95 md:text-[30px]"
								/>
								<div
									data-carousel-lb-counter
									class="mt-2 font-mono text-[10px] tracking-[0.18em] text-white/40 uppercase md:mt-3"
								/>
							</div>
						</div>
					</div>
				</main>
			</div>
		</Layout>
	)
}

<script>
	import { GITHUB_API_BASE } from '../../lib/site';

	function initProject() {
		const article = document.querySelector('[data-project-article]') as HTMLElement | null;
		if (!article) return;

		// External links + footnote backref (same as writing)
		article.querySelectorAll('a').forEach((link) => {
			const a = link as HTMLAnchorElement;
			if (a.hostname && a.hostname !== window.location.hostname) {
				a.setAttribute('target', '_blank');
				a.setAttribute('rel', 'noreferrer noopener');
				if (!a.querySelector('.sr-only')) {
					const sr = document.createElement('span');
					sr.className = 'sr-only';
					sr.textContent = '(opens in new tab)';
					a.appendChild(sr);
				}
			}
		});
		article.addEventListener('click', (e) => {
			const link = (e.target as Element).closest(
				'.footnote-backref, .data-footnote-backref, .footnote-ref'
			) as HTMLAnchorElement | null;
			if (!link) return;
			const href = link.getAttribute('href');
			if (!href?.startsWith('#')) return;
			const target = document.getElementById(href.slice(1));
			if (!target) return;
			e.preventDefault();
			const tr = target.getBoundingClientRect();
			const isVisible = tr.top >= 0 && tr.bottom <= window.innerHeight;
			if (!isVisible) {
				window.scrollTo({
					top: window.scrollY + tr.top - 80,
					behavior: 'instant' as ScrollBehavior
				});
			}
			history.replaceState(history.state, '', '#' + href.slice(1));
			const anim = target.id.startsWith('fnref-') ? 'fnref-flash' : 'fn-flash';
			(target as HTMLElement).style.animation = 'none';
			void (target as HTMLElement).offsetWidth;
			(target as HTMLElement).style.animation = `${anim} 2s ease-out forwards`;
		});

		// Last commit date (client-side fetch with localStorage cache)
		const lastCommitEl = document.querySelector('[data-last-commit]') as HTMLElement | null;
		if (lastCommitEl) {
			const github = lastCommitEl.dataset['github'];
			if (github) {
				const CACHE_KEY = 'gh-last-commit-cache';
				const CACHE_TTL = 12 * 60 * 60 * 1000;
				function loadCache(): any[] | null {
					try {
						const stored = localStorage.getItem(CACHE_KEY);
						if (!stored) return null;
						const parsed = JSON.parse(stored);
						if (
							parsed &&
							Array.isArray(parsed.repositories) &&
							typeof parsed.timestamp === 'number'
						) {
							if (Date.now() - parsed.timestamp > CACHE_TTL) {
								localStorage.removeItem(CACHE_KEY);
								return null;
							}
							return parsed.repositories;
						}
						return null;
					} catch {
						return null;
					}
				}
				function findRepo(repos: any[], url: string) {
					const norm = (u: string) =>
						u
							.replace(/^https?:\/\//, '')
							.replace(/\/+$/, '')
							.replace(/\.git$/, '')
							.toLowerCase();
					const target = norm(url);
					return repos.find((r) => norm(r.url) === target)?.lastCommitDate ?? null;
				}
				function formatDate(d: string) {
					try {
						return new Intl.DateTimeFormat('en-GB', {
							day: '2-digit',
							month: 'short',
							year: 'numeric'
						}).format(new Date(d));
					} catch {
						return d;
					}
				}
				const cached = loadCache();
				if (cached) {
					const date = findRepo(cached, github);
					if (date) {
						lastCommitEl.textContent = `Last commit: ${formatDate(date)}`;
						lastCommitEl.classList.remove('hidden');
					}
				} else {
					fetch(`${GITHUB_API_BASE}/api/last-commit`)
						.then((r) => (r.ok ? r.json() : null))
						.then((data) => {
							if (!data?.repositories) return;
							try {
								localStorage.setItem(
									CACHE_KEY,
									JSON.stringify({ repositories: data.repositories, timestamp: Date.now() })
								);
							} catch {}
							const date = findRepo(data.repositories, github);
							if (date) {
								lastCommitEl.textContent = `Last commit: ${formatDate(date)}`;
								lastCommitEl.classList.remove('hidden');
							}
						})
						.catch(() => {});
				}
			}
		}

		// Hydrate carousels — SSR renders <figure> 1:1 to Carousel.svelte, JS hydrates in-place
		const carousels = article.querySelectorAll('[data-carousel]');

		// ---------- Lightbox (single shared overlay across all carousels) ----------
		// Controls are bound once here; each carousel only registers its open button,
		// passing a sync-callback so in-page state stays in step with the overlay.
		const lb = document.querySelector('[data-carousel-lightbox]') as HTMLElement | null;
		const lbImg = document.querySelector('[data-carousel-lb-image]') as HTMLImageElement | null;
		const lbTitle = document.querySelector('[data-carousel-lb-title]') as HTMLElement | null;
		const lbCounter = document.querySelector('[data-carousel-lb-counter]') as HTMLElement | null;
		const lbClose = document.querySelector('[data-carousel-lb-close]') as HTMLElement | null;
		const lbPrev = document.querySelector('[data-carousel-lb-prev]') as HTMLButtonElement | null;
		const lbNext = document.querySelector('[data-carousel-lb-next]') as HTMLButtonElement | null;
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		interface LbState {
			images: string[];
			captions: string[];
			index: number;
			onIndexChange: (index: number) => void;
			trigger: HTMLElement | null;
		}
		let lbState: LbState | null = null;

		function lbFocusables(): HTMLButtonElement[] {
			if (!lb) return [];
			return Array.from(
				lb.querySelectorAll<HTMLButtonElement>(
					'[data-carousel-lb-close], [data-carousel-lb-prev], [data-carousel-lb-next]'
				)
			).filter((b) => !b.classList.contains('hidden'));
		}

		function renderLb(withDip = false) {
			if (!lbState || !lbImg || !lbTitle || !lbCounter) return;
			const { images, captions, index } = lbState;
			lbImg.src = images[index]!;
			lbImg.alt = captions[index] || `Image ${index + 1}`;
			lbTitle.textContent = captions[index] || '';
			lbCounter.textContent = `${index + 1} / ${images.length}`;
			// Dip-and-return crossfade — reads as a swap, not a hard cut
			if (withDip && !prefersReducedMotion) {
				lbImg.style.opacity = '0.35';
				requestAnimationFrame(() =>
					requestAnimationFrame(() => {
						lbImg.style.opacity = '';
					})
				);
			}
		}

		function openLb(
			images: string[],
			captions: string[],
			index: number,
			onIndexChange: (index: number) => void,
			trigger: HTMLElement | null
		) {
			lbState = { images, captions, index, onIndexChange, trigger };
			if (!lb) return;
			// No ‹ › controls for single-image sets
			lbPrev?.classList.toggle('hidden', images.length < 2);
			lbNext?.classList.toggle('hidden', images.length < 2);
			lb.setAttribute('data-open', '');
			// Pad for scrollbar, hide overflow
			const sw = window.innerWidth - document.documentElement.clientWidth;
			if (sw > 0) document.body.style.paddingRight = `${sw}px`;
			document.body.style.overflow = 'hidden';
			renderLb();
			lbClose?.focus();
		}

		function closeLb() {
			if (lb) lb.removeAttribute('data-open');
			document.body.style.overflow = '';
			document.body.style.paddingRight = '';
			if (lbImg) lbImg.style.opacity = '';
			const trigger = lbState?.trigger ?? null;
			lbState = null;
			trigger?.focus();
		}

		function lbStep(dir: number) {
			if (!lbState || lbState.images.length < 2) return;
			const count = lbState.images.length;
			lbState.index = (lbState.index + dir + count) % count;
			lbState.onIndexChange(lbState.index);
			renderLb(true);
		}

		lbClose?.addEventListener('click', closeLb);
		lbNext?.addEventListener('click', () => lbStep(1));
		lbPrev?.addEventListener('click', () => lbStep(-1));
		lb?.addEventListener('click', (e) => {
			if (
				!(e.target as Element).closest(
					'img, button, [data-carousel-lb-title], [data-carousel-lb-counter]'
				)
			) {
				closeLb();
			}
		});
		document.addEventListener('keydown', (e) => {
			if (!lbState || !lb) return;
			if (e.key === 'Escape') {
				closeLb();
			} else if (e.key === 'ArrowRight') {
				lbStep(1);
			} else if (e.key === 'ArrowLeft') {
				lbStep(-1);
			} else if (e.key === 'Tab') {
				// Keep focus cycling within the dialog
				const buttons = lbFocusables();
				if (buttons.length === 0) return;
				const first = buttons[0]!;
				const last = buttons[buttons.length - 1]!;
				const current = document.activeElement;
				if (e.shiftKey && (current === first || !lb.contains(current))) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && current === last) {
					e.preventDefault();
					first.focus();
				}
			}
		});

		// Touch swipe to navigate — quick horizontal flick, ignored otherwise
		let swipeStartX: number | null = null;
		let swipeStartY = 0;
		let swipeStartT = 0;
		lb?.addEventListener(
			'touchstart',
			(e) => {
				if (e.touches.length !== 1) return;
				const t = e.touches[0]!;
				swipeStartX = t.clientX;
				swipeStartY = t.clientY;
				swipeStartT = Date.now();
			},
			{ passive: true }
		);
		lb?.addEventListener(
			'touchend',
			(e) => {
				if (swipeStartX === null) return;
				const startX = swipeStartX;
				const startY = swipeStartY;
				const elapsed = Date.now() - swipeStartT;
				swipeStartX = null;
				const t = e.changedTouches[0];
				if (!t) return;
				const dx = t.clientX - startX;
				const dy = t.clientY - startY;
				if (elapsed > 400) return;
				if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
					lbStep(dx < 0 ? 1 : -1);
				}
			},
			{ passive: true }
		);

		carousels.forEach((el) => {
			const rawImages = el.getAttribute('data-images');
			const rawCaptions = el.getAttribute('data-captions');
			let images: string[] = [];
			let captions: string[] = [];
			function decode(s: string | null) {
				if (!s) return null;
				// Handle both &quot; and &#39; / &amp; from SSR escaping
				return s
					.replace(/&quot;/g, '"')
					.replace(/&#39;/g, "'")
					.replace(/&amp;/g, '&');
			}
			try {
				const dec = decode(rawImages);
				images = dec ? JSON.parse(dec) : [];
			} catch {}
			try {
				const dec = decode(rawCaptions);
				captions = dec ? JSON.parse(dec) : [];
			} catch {}
			if (images.length === 0) return;

			let activeIndex = 0;

			const isFigure = el.tagName.toLowerCase() === 'figure';
			// SSR path: hydrate existing figure
			let img = el.querySelector('[data-carousel-image]') as HTMLImageElement | null;
			let openBtn = el.querySelector('[data-carousel-open]') as HTMLButtonElement | null;
			let prevBtn = el.querySelector('[data-carousel-prev]') as HTMLButtonElement | null;
			let nextBtn = el.querySelector('[data-carousel-next]') as HTMLButtonElement | null;
			let counter = el.querySelector('[data-carousel-counter]') as HTMLElement | null;
			let captionEl = el.querySelector('[data-carousel-caption]') as HTMLElement | null;

			// Legacy placeholder <div> — build figure if SSR not present
			if (!isFigure || !img || !openBtn) {
				const figure = document.createElement('figure');
				figure.className = 'my-10';
				(figure as HTMLElement).setAttribute('data-carousel', '');
				if (rawImages) figure.setAttribute('data-images', rawImages);
				if (rawCaptions) figure.setAttribute('data-captions', rawCaptions);
				const h = el.getAttribute('data-height') || 'h-[320px] md:h-[400px]';
				figure.setAttribute('data-height', h);
				const wrap = document.createElement('div');
				wrap.className = `relative w-full overflow-hidden rounded-sm border border-bd bg-frame ${h}`;
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.setAttribute('data-carousel-open', '');
				btn.className = 'group block h-full w-full cursor-zoom-in';
				btn.setAttribute('aria-label', `View image 1 in lightbox`);
				const newImg = document.createElement('img');
				newImg.setAttribute('data-carousel-image', '');
				newImg.className =
					'm-0 h-full w-full object-contain transition-[filter] duration-300 ease-out group-hover:brightness-105';
				newImg.loading = 'lazy';
				(newImg as any).decoding = 'async';
				newImg.src = images[0]!;
				newImg.alt = captions[0] || `Image 1`;
				const newCaption = document.createElement('figcaption');
				newCaption.setAttribute('data-carousel-caption', '');
				newCaption.className = 'mt-3 text-center font-sans text-[11px] leading-relaxed text-ink-70';
				btn.appendChild(newImg);
				wrap.appendChild(btn);
				if (images.length > 1) {
					prevBtn = document.createElement('button');
					prevBtn.type = 'button';
					prevBtn.setAttribute('data-carousel-prev', '');
					prevBtn.className =
						'absolute top-1/2 left-3 z-10 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/5 text-white transition-[background-color,opacity,scale] duration-200 ease-out hover:bg-white/10 active:scale-95 md:h-11 md:w-11';
					prevBtn.setAttribute('aria-label', 'Previous image');
					prevBtn.innerHTML =
						'<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" /></svg>';
					nextBtn = document.createElement('button');
					nextBtn.type = 'button';
					nextBtn.setAttribute('data-carousel-next', '');
					nextBtn.className =
						'absolute top-1/2 right-3 z-10 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/5 text-white transition-[background-color,opacity,scale] duration-200 ease-out hover:bg-white/10 active:scale-95 md:h-11 md:w-11';
					nextBtn.setAttribute('aria-label', 'Next image');
					nextBtn.innerHTML =
						'<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6" /></svg>';
					counter = document.createElement('div');
					counter.setAttribute('data-carousel-counter', '');
					counter.className =
						'absolute right-3 bottom-3 font-mono text-[10px] tracking-[0.18em] text-white/40 select-none';
					counter.textContent = `1 / ${images.length}`;
					wrap.appendChild(prevBtn);
					wrap.appendChild(nextBtn);
					wrap.appendChild(counter);
				}
				figure.appendChild(wrap);
				newCaption.textContent = captions[0] || '';
				if (!captions[0]) (newCaption as HTMLElement).style.display = 'none';
				figure.appendChild(newCaption);
				el.replaceWith(figure);
				img = newImg;
				openBtn = btn;
				captionEl = newCaption;
			}

			function render() {
				if (!img || !openBtn || !captionEl) return;
				img.src = images[activeIndex]!;
				img.alt = captions[activeIndex] || `Image ${activeIndex + 1}`;
				openBtn.setAttribute(
					'aria-label',
					`View image ${activeIndex + 1} in lightbox: ${captions[activeIndex] || ''}`
				);
				captionEl.textContent = captions[activeIndex] || '';
				(captionEl as HTMLElement).style.display = captions[activeIndex] ? '' : 'none';
				if (counter) counter.textContent = `${activeIndex + 1} / ${images.length}`;
			}

			prevBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				activeIndex = (activeIndex - 1 + images.length) % images.length;
				render();
			});
			nextBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				activeIndex = (activeIndex + 1) % images.length;
				render();
			});

			openBtn?.addEventListener('click', () => {
				openLb(
					images,
					captions,
					activeIndex,
					(i) => {
						activeIndex = i;
						render();
					},
					openBtn
				);
			});

			render();
		});
	}

	initProject();
	document.addEventListener('astro:after-swap', initProject);
</script>
