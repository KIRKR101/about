---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getArtGroups, artGroupSlug, artThumbnail } from '../../lib/art-groups';

export const prerender = true;
export function getStaticPaths() {
	return getArtGroups().map((group) => ({
		params: { school: artGroupSlug(group.name) },
		props: { name: group.name }
	}));
}
const { name } = Astro.props;
const group = getArtGroups().find((item) => item.name === name);
---

<Layout title={`${name} | kirkr.xyz`} description={`A collection of ${name}.`}>
	<div class="flex min-h-[calc(100dvh-4rem)] flex-col items-center px-6 py-6 md:py-16">
		<main class="w-full max-w-[600px]">
			<div class="py-4">
				<h1 class="font-serif text-[48px] leading-tight tracking-[-1px] text-ink">
					{name}<span class="opacity-40">.</span>
				</h1>
			</div>
			<div class="mb-10 h-px bg-bd"></div>
			<div class="columns-1 gap-5 sm:columns-2">
				{
					group?.entries.map(([id, artwork]) => (
						<figure class="mb-5 break-inside-avoid">
							<a href={`/art/${artGroupSlug(name)}/${id}`} class="group block no-underline">
								<img
									src={artThumbnail(artwork.thumbnail)}
									alt={artwork.title}
									style={`aspect-ratio: ${artwork.aspectRatio}`}
									class="h-auto w-full rounded-sm border border-bd object-cover"
									loading="lazy"
								/>
								<div class="mt-3 font-serif text-[21px] leading-tight text-ink-90 group-hover:underline">
									{artwork.title}
								</div>
								<div class="mt-1 font-sans text-[11px] text-ink-50">
									{artwork.data.find(([key]) => key === 'artist')?.[1]}
								</div>
							</a>
						</figure>
					))
				}
			</div>
			<Footer />
		</main>
	</div>
</Layout>
