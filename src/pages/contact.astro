---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact | kirkr.xyz" description="Contact Theo.">
	<div class="flex min-h-[calc(100dvh-4rem)] flex-col items-center px-6 py-6 md:py-16">
		<main class="w-full max-w-[600px]">
			<div class="py-4">
				<h1 class="font-serif text-[48px] leading-tight text-ink">
					Contact<span class="opacity-40">.</span>
				</h1>
			</div>
			<div class="mb-8 h-px bg-bd"></div>
			<p class="font-sans text-[15px] leading-[1.8] text-ink-80">
				The best way to reach me is by email.
			</p>
			<a
				href="mailto:theo@kirkr.xyz"
				class="group mt-6 inline-flex items-center gap-1.5 font-mono text-[12px] tracking-wider text-ink underline decoration-ink/20 underline-offset-2 transition-colors duration-100 hover:decoration-ink"
			>
				theo@kirkr.xyz
				<svg
					width="14"
					height="14"
					viewBox="0 0 16 16"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
					class="text-ink-30 group-hover:text-ink-70"
				>
					<path
						d="M12 10V4m0 0H6m6 0l-7.833 7.833"
						stroke="currentColor"
						stroke-width="1"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
			<figure class="mt-10">
				<img
					src="/friedrich-morning-mist.webp"
					alt="Morning Mist in the Mountains, by Caspar David Friedrich"
					width="720"
					height="480"
					style="aspect-ratio: 720 / 480"
					class="h-auto w-full rounded-sm object-cover"
					loading="lazy"
				/>
				<figcaption class="mt-6 text-center font-mono text-[11px] leading-relaxed text-ink-70">
					Caspar David Friedrich - Morning Mist in the Mountains
				</figcaption>
			</figure>
			<Footer />
		</main>
	</div>
</Layout>
