---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import {
	preprocessMarkdown,
	renderMarkdown,
	extractHeadings,
	getReadingMinutes
} from '../../scripts/render-markdown';

export const prerender = false;

let entry = (Astro.props as { entry?: CollectionEntry<'writings'> }).entry;
if (!entry) {
	const slug = (Astro.params as { slug?: string }).slug;
	if (slug) {
		const writings = await getCollection('writings');
		entry = writings.find((e: CollectionEntry<'writings'>) => e.id === slug);
	}
}
if (!entry) {
	return Astro.redirect('/404');
}

if (Astro.locals.prefersMarkdown) {
	return new Response(entry.body ?? '', {
		status: 200,
		headers: {
			'Content-Type': 'text/markdown; charset=utf-8',
			Vary: 'Accept'
		}
	});
}

let title = entry.data.title;
let longTitle: string | undefined = entry.data.longTitle;
let date = entry.data.date;
let snippet = entry.data.snippet;
let htmlContent = '';

const preprocessed = preprocessMarkdown(entry.body ?? '');
htmlContent = renderMarkdown(preprocessed);
const headings = extractHeadings(preprocessed);
const readingMinutes = getReadingMinutes(preprocessed);
const notFound = false;

function formatDate(dateString: string) {
	try {
		return new Intl.DateTimeFormat('en-GB', {
			day: '2-digit',
			month: 'short',
			year: 'numeric'
		}).format(new Date(dateString));
	} catch {
		return dateString;
	}
}
---

{
	notFound ? (
		<Layout title={`Not found`}>
			<div class="flex min-h-full flex-col items-center justify-start px-6 pt-[20vh] pb-6 lg:pt-[24vh] lg:pb-16">
				<main class="w-full max-w-[600px] pl-6 md:pl-10">
					<div class="font-sans text-[11px] tracking-[0.1em] text-ink-70 uppercase">Error 404</div>
					<div class="mt-3 font-serif text-[26px] leading-tight text-ink-90">Page not found</div>
					<p class="mt-4 font-sans text-[14px] leading-[1.7] text-ink-70">
						The page you're looking for doesn't exist or has been moved.
					</p>
					<a
						href="/"
						class="group mt-8 inline-flex cursor-pointer items-center gap-1.5 font-sans text-[13px] font-medium text-ink-70 no-underline transition-colors duration-150 hover:text-ink"
					>
						<svg
							width="12"
							height="12"
							viewBox="0 0 256 256"
							fill="currentColor"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
							class="text-ink-70 transition-colors duration-150 group-hover:text-ink"
						>
							<path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z" />
						</svg>
						Return home
					</a>
				</main>
			</div>
		</Layout>
	) : (
		<Layout
			title={`${title}`}
			description={snippet || 'Read writings and articles.'}
			ogImage={`/social/writing/${entry.id}.webp`}
			ogType="article"
		>
			<div class="flex min-h-0 flex-col items-center px-6 py-6 font-sans md:py-16">
				<main class="w-full max-w-[600px]">
					<div class="py-4">
						<h1 class="font-serif text-[42px] leading-tight tracking-[-1px] text-balance text-ink">
							{longTitle || title}
						</h1>
						<div class="mt-3 flex items-center justify-between font-mono text-[11px] tracking-[0.1em] text-ink-70 uppercase">
							{date ? <span>{formatDate(date)}</span> : <span />}
							<span>{readingMinutes} minute read</span>
						</div>
					</div>

					<div class="mb-8 h-px bg-bd" />

					<article data-writing-article class="prose max-w-none" set:html={htmlContent} />

					{/* Lightbox for prose images (single shared overlay; JS toggles data-open) */}
					<div
						data-writing-lightbox
						class="ease-out-soft invisible fixed inset-0 z-60 flex scale-[0.98] bg-[#0b0b0b]/95 opacity-0 transition-[opacity,visibility,scale] duration-100 outline-none select-none data-[open]:visible data-[open]:scale-100 data-[open]:opacity-100 motion-reduce:transition-none"
						role="dialog"
						aria-modal="true"
						tabindex="-1"
					>
						<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.04),transparent_60%)]" />
						<button
							type="button"
							data-writing-lightbox-close
							class="absolute top-4 right-4 z-50 flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/5 text-white transition-[background-color,opacity,scale] duration-100 ease-out hover:bg-white/10 focus-visible:outline-white/60 active:scale-95 md:top-6 md:right-6 md:h-11 md:w-11"
							aria-label="Close lightbox"
						>
							<svg
								class="h-5 w-5"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
							>
								<path d="M18 6L6 18M6 6l12 12" />
							</svg>
						</button>
						<div class="absolute inset-x-1 top-2 bottom-2 flex [touch-action:pinch-zoom] items-center justify-center">
							<img
								data-writing-lightbox-image
								src=""
								alt=""
								class="max-h-full max-w-full object-contain"
								draggable="false"
							/>
						</div>
						<div
							data-writing-lightbox-caption
							class="pointer-events-none absolute inset-x-6 bottom-6 text-center font-sans text-[13px] leading-relaxed text-white/70 empty:hidden"
						/>
					</div>
				</main>
				<aside class="fixed top-32 right-8 hidden w-60 xl:block">
					<TableOfContents headings={headings} levels={3} />
				</aside>
			</div>
		</Layout>
	)
}

<script>
	function initWriting() {
		const article = document.querySelector('[data-writing-article]') as HTMLElement | null;
		if (!article) return;

		// External links: add target="_blank" and rel, plus sr-only
		article.querySelectorAll('a').forEach((link) => {
			const a = link as HTMLAnchorElement;
			if (a.hostname && a.hostname !== window.location.hostname) {
				a.setAttribute('target', '_blank');
				a.setAttribute('rel', 'noreferrer noopener');
				if (!a.querySelector('.sr-only')) {
					const sr = document.createElement('span');
					sr.className = 'sr-only';
					sr.textContent = '(opens in new tab)';
					a.appendChild(sr);
				}
			}
		});

		// Footnote backref smooth handling (mirrors src/lib/actions.ts:footnoteBackref)
		article.addEventListener('click', (e) => {
			const link = (e.target as Element).closest(
				'.footnote-backref, .data-footnote-backref, .footnote-ref'
			) as HTMLAnchorElement | null;
			if (!link) return;
			const href = link.getAttribute('href');
			if (!href?.startsWith('#')) return;
			const target = document.getElementById(href.slice(1));
			if (!target) return;

			e.preventDefault();

			const tr = target.getBoundingClientRect();
			const isVisible = tr.top >= 0 && tr.bottom <= window.innerHeight;

			if (!isVisible) {
				window.scrollTo({
					top: window.scrollY + tr.top - 80,
					behavior: 'instant' as ScrollBehavior
				});
			}

			history.replaceState(history.state, '', '#' + href.slice(1));

			const anim = target.id.startsWith('fnref-') ? 'fnref-flash' : 'fn-flash';
			(target as HTMLElement).style.animation = 'none';
			void (target as HTMLElement).offsetWidth;
			(target as HTMLElement).style.animation = `${anim} 2s ease-out forwards`;
		});

		// Image lightbox — click an article image to view it fullscreen
		const lightbox = document.querySelector('[data-writing-lightbox]') as HTMLElement | null;
		const lightboxImg = document.querySelector(
			'[data-writing-lightbox-image]'
		) as HTMLImageElement | null;
		const lightboxCaption = document.querySelector(
			'[data-writing-lightbox-caption]'
		) as HTMLElement | null;
		const lightboxClose = document.querySelector(
			'[data-writing-lightbox-close]'
		) as HTMLButtonElement | null;
		let lightboxTrigger: HTMLElement | null = null;

		const zoomable = (img: Element) => article.contains(img) && !img.closest('a');
		const isOpen = () => !!lightbox?.hasAttribute('data-open');

		function openLightbox(image: HTMLImageElement) {
			if (!lightbox || !lightboxImg) return;
			lightboxImg.src = image.currentSrc || image.src;
			lightboxImg.alt = image.alt;
			if (lightboxCaption) lightboxCaption.textContent = image.alt || '';
			lightboxTrigger = image;
			lightbox.setAttribute('data-open', '');
			// Pad for scrollbar, hide overflow
			const sw = window.innerWidth - document.documentElement.clientWidth;
			if (sw > 0) document.body.style.paddingRight = `${sw}px`;
			document.body.style.overflow = 'hidden';
			lightboxClose?.focus();
		}

		function closeLightbox() {
			if (lightbox) lightbox.removeAttribute('data-open');
			document.body.style.overflow = '';
			document.body.style.paddingRight = '';
			lightboxTrigger?.focus();
			lightboxTrigger = null;
		}

		// Zoomable cursor + keyboard access (native markdown <img> is not interactive)
		article.querySelectorAll('img').forEach((img) => {
			const el = img as HTMLElement;
			if (!zoomable(img)) return;
			el.style.cursor = 'zoom-in';
			el.setAttribute('tabindex', '0');
			el.setAttribute('role', 'button');
			el.setAttribute('aria-label', img.alt ? `Zoom image: ${img.alt}` : 'Zoom image');
		});

		article.addEventListener('click', (e) => {
			const img = (e.target as Element).closest('img');
			if (!img || !zoomable(img)) return;
			e.preventDefault();
			openLightbox(img as HTMLImageElement);
		});

		article.addEventListener('keydown', (e) => {
			if (e.key !== 'Enter' && e.key !== ' ') return;
			const target = e.target as Element;
			if (target.tagName !== 'IMG' || !zoomable(target)) return;
			e.preventDefault();
			openLightbox(target as HTMLImageElement);
		});

		lightboxClose?.addEventListener('click', closeLightbox);
		lightbox?.addEventListener('click', (e) => {
			if ((e.target as Element).closest('img, button, [data-writing-lightbox-caption]')) return;
			closeLightbox();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && isOpen()) closeLightbox();
		});
	}

	initWriting();
	document.addEventListener('astro:after-swap', initWriting);
</script>
