---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Right now | kirkr.xyz" description="What I am listening to, reading, and watching right now.">
	<div class="flex min-h-[calc(100dvh-4rem)] flex-col items-center px-6 py-6 md:py-16"><main class="w-full max-w-[600px]">
		<div class="py-4"><h1 class="font-serif text-[48px] leading-tight tracking-[-1px] text-ink">Right now<span class="opacity-40">.</span></h1></div><div class="mb-8 h-px bg-bd"></div>
		<section class="border-b border-bd pb-7"><div class="mb-5 font-mono text-[11px] tracking-wider text-ink-70 uppercase">Listening</div><div class="flex items-center gap-6"><div class="h-32 w-32 shrink-0 overflow-hidden rounded-sm bg-ink/5"><img data-track-image alt="" class="hidden h-full w-full object-cover" /></div><div class="min-w-0"><div data-track-title class="font-serif text-[24px] leading-tight text-ink-90">Loading</div><div data-track-artist class="mt-2 font-sans text-[13px] text-ink-70">Checking Spotify…</div></div></div></section>
		<section class="border-b border-bd py-7"><div class="mb-5 font-mono text-[11px] tracking-wider text-ink-70 uppercase">Films</div><div data-films-loading class="font-mono text-[11px] text-ink-50">Loading recent films…</div><div data-films-list class="hidden grid grid-cols-3 gap-4"></div><div data-films-error class="hidden font-mono text-[11px] text-ink-50">Films unavailable right now.</div></section>
		<section class="py-7"><div class="mb-5 font-mono text-[11px] tracking-wider text-ink-70 uppercase">Books</div><div data-books-loading class="font-mono text-[11px] text-ink-50">Loading books…</div><div data-books-list class="hidden grid grid-cols-3 gap-4"></div><div data-books-error class="hidden font-mono text-[11px] text-ink-50">Books unavailable right now.</div></section>
		<Footer />
	</main></div>
</Layout>

<script>
	const trackImage = document.querySelector('[data-track-image]') as HTMLImageElement | null;
	const trackTitle = document.querySelector('[data-track-title]');
	const trackArtist = document.querySelector('[data-track-artist]');
	fetch('https://spotify.kirkr.xyz/api/now-playing').then((r) => r.json()).then((data) => { if (trackTitle) trackTitle.textContent = data.title || 'Nothing playing'; if (trackArtist) trackArtist.textContent = data.artist || '—'; if (trackImage && data.images?.[0]?.url) { trackImage.src = data.images[0].url; trackImage.alt = data.title || ''; trackImage.classList.remove('hidden'); } }).catch(() => { if (trackTitle) trackTitle.textContent = 'Nothing playing'; if (trackArtist) trackArtist.textContent = 'Spotify unavailable'; });
	const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!);
	const stars = (rating: string | number) => { const value = Number(rating); return value ? '★'.repeat(Math.floor(value)) + (value % 1 ? '½' : '') : ''; };
	fetch('https://letterboxd.kirkr.xyz/kirkr101/rss/').then((r) => { if (!r.ok) throw new Error(`Films request failed: ${r.status}`); return r.text(); }).then((xml) => { const doc = new DOMParser().parseFromString(xml, 'text/xml'); if (doc.querySelector('parsererror')) throw new Error('Films feed could not be parsed'); const films = [...doc.querySelectorAll('item')].slice(0, 3); if (films.length === 0) throw new Error('Films feed was empty'); const list = document.querySelector('[data-films-list]'); const loading = document.querySelector('[data-films-loading]'); if (!list) return; list.innerHTML = films.map((item) => { const title = item.querySelector('filmTitle')?.textContent || 'Untitled'; const year = item.querySelector('filmYear')?.textContent || ''; const rating = item.querySelector('memberRating')?.textContent || ''; const link = item.querySelector('link')?.textContent || '#'; const description = item.querySelector('description')?.textContent || ''; const poster = new DOMParser().parseFromString(description, 'text/html').querySelector('img')?.getAttribute('src') || ''; return `<a href="${link}" target="_blank" rel="noopener noreferrer" class="group min-w-0 no-underline"><div class="aspect-[2/3] overflow-hidden rounded-sm border border-bd bg-card-bg"><img src="${poster}" alt="${escapeHtml(title)}" class="h-full w-full object-cover" loading="lazy" onerror="this.style.opacity='0'" /></div><div class="mt-2 truncate font-serif text-[16px] text-ink-90 group-hover:underline">${escapeHtml(title)}</div><div class="mt-1 flex justify-between gap-2 font-mono text-[10px] text-ink-50"><span>${escapeHtml(year)}</span><span class="text-ink-70">${escapeHtml(stars(rating))}</span></div></a>`; }).join(''); loading?.classList.add('hidden'); list.classList.remove('hidden'); }).catch(() => { document.querySelector('[data-films-loading]')?.classList.add('hidden'); document.querySelector('[data-films-error]')?.classList.remove('hidden'); });
	fetch('https://hardcover.kirkr.xyz').then((r) => { if (!r.ok) throw new Error(`Books request failed: ${r.status}`); return r.json(); }).then((data) => { const list = document.querySelector('[data-books-list]'); const loading = document.querySelector('[data-books-loading]'); if (!list) return; const books = [...(data.currently_reading || []).map((item: any) => ({ ...item, inProgress: true })), ...(data.previously_read || []).map((item: any) => ({ ...item, inProgress: false }))].slice(0, 3); if (books.length === 0) throw new Error('Books feed was empty'); list.innerHTML = books.map((item: any) => { const book = item.book; const rating = item.user_book?.rating; const progress = item.inProgress && item.progress?.pages_read != null && item.progress?.total_pages != null ? `${item.progress.pages_read} / ${item.progress.total_pages}` : ''; const title = book.title || 'Untitled'; const cover = book.cover_url || ''; const link = `https://hardcover.app/books/${book.slug}?referrer_id=120657`; return `<a href="${link}" target="_blank" rel="noopener noreferrer" class="group min-w-0 no-underline"><div class="aspect-[2/3] overflow-hidden rounded-sm border border-bd bg-card-bg"><img src="${cover}" alt="${escapeHtml(title)}" class="h-full w-full object-cover" loading="lazy" onerror="this.style.opacity='0'" /></div><div class="mt-2 truncate font-serif text-[16px] text-ink-90 group-hover:underline">${escapeHtml(title)}</div><div class="mt-1 flex justify-between gap-2 font-mono text-[10px] text-ink-50"><span class="truncate">${escapeHtml(book.authors?.[0] || '')}</span><span class="shrink-0 text-ink-70">${escapeHtml(stars(rating))}</span></div>${progress ? `<div class="mt-1 font-mono text-[10px] text-ink-50">${escapeHtml(progress)}</div>` : ''}</a>`; }).join(''); loading?.classList.add('hidden'); list.classList.remove('hidden'); }).catch(() => { document.querySelector('[data-books-loading]')?.classList.add('hidden'); document.querySelector('[data-books-error]')?.classList.remove('hidden'); });
</script>
