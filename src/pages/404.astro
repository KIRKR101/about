---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { notFoundMarkdown } from '../lib/markdown-helpers';
// @ts-ignore - false positive
void notFoundMarkdown;

if (Astro.locals.prefersMarkdown) {
	return new Response(notFoundMarkdown(), {
		status: 404,
		headers: {
			'Content-Type': 'text/markdown; charset=utf-8',
			Vary: 'Accept'
		}
	});
}
---

<Layout title="404">
	<div
		class="flex min-h-full flex-col items-center justify-start px-6 pt-[20vh] pb-6 lg:pt-[24vh] lg:pb-16"
	>
		<main class="w-full max-w-[600px] pl-6 md:pl-10">
			<div class="font-sans text-[11px] tracking-[0.1em] text-ink-70 uppercase">Error 404</div>
			<div class="mt-3 font-serif text-[26px] leading-tight text-ink-90">Page not found</div>
			<p class="mt-4 font-sans text-[14px] leading-[1.7] text-ink-70">
				The page you're looking for doesn't exist or has been moved. Browse the site index at
				{' '}
				<a href="/llms.txt" class="underline transition-colors hover:text-ink">/llms.txt</a>
				{' '}or the full page list at{' '}
				<a href="/sitemap.xml" class="underline transition-colors hover:text-ink">/sitemap.xml</a>.
				{' '}The text of every page is also available as{' '}
				<a href="/llms-full.txt" class="underline transition-colors hover:text-ink"
					>/llms-full.txt</a
				>.
			</p>
			<a
				href="/"
				class="group mt-8 inline-flex cursor-pointer items-center gap-1.5 font-sans text-[13px] font-medium text-ink-70 no-underline transition-colors duration-150 hover:text-ink"
			>
				<svg
					width="12"
					height="12"
					viewBox="0 0 256 256"
					fill="currentColor"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
					class="text-ink-70 transition-colors duration-150 group-hover:text-ink"
				>
					<path
						d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"
					></path>
				</svg>
				Return home
			</a>

			<Footer />
		</main>
	</div>
</Layout>
