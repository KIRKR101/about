---
// Adapted from Cosmic Themes' Astro table of contents component
// (https://cosmicthemes.com/blog/astro-table-of-contents-component):
// auto-generated heading links + scroll-spy highlighting via IntersectionObserver.
interface Heading {
	depth: number; // The heading level (h1 = 1, h2 = 2, etc)
	slug: string; // The ID of the heading for linking
	text: string; // The text content of the heading
}
interface Props {
	headings: Heading[]; // Array of headings from the markdown content
	levels?: 1 | 2 | 3; // How many levels of headers to show in TOC (default: 2)
}

const { headings, levels = 2 } = Astro.props as Props;
// Filter headings to only show up to the specified level
const filteredHeadings = headings.filter((heading) => heading.depth <= levels);
---

{
	filteredHeadings.length > 0 && (
		<nav aria-label="Table of contents" class="max-h-[calc(100vh-10rem)] overflow-auto rounded-sm border border-bd p-4 text-sm leading-snug">
			<h4 class="font-sans text-[11px] tracking-[0.1em] text-ink-70 uppercase">Table of Contents</h4>
			<ul class="mt-3 flex flex-col gap-2">
				{filteredHeadings.map((heading) => (
					<li
						class:list={{
							'pl-3': heading.depth === 2,
							'pl-6': heading.depth === 3
						}}
					>
						<a
							href={`#${heading.slug}`}
							class="toc-link font-sans text-[12px] text-ink-50 no-underline transition-colors hover:text-ink"
						>
							{heading.text}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	.toc-link {
		position: relative;
		padding-left: 6px;
	}
	.toc-link::before {
		content: '';
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 2px;
		height: 1.1em;
		border-radius: 1px;
		background: transparent;
	}
	.toc-current {
		color: var(--ink-80);
	}
	.toc-current::before {
		background: var(--ink-80);
	}
</style>

<script>
	// Wrapper for writing content
	let wrappingElement: Element | null;
	let observeHeaderTags: IntersectionObserver;
	let allHeaderTags: NodeListOf<Element>;

	// Function that runs when the Intersection Observer fires
	function setCurrent(entries: IntersectionObserverEntry[]) {
		const allSectionLinks = document.querySelectorAll('.toc-link');
		entries.map((entry) => {
			if (entry.isIntersecting === true) {
				allSectionLinks.forEach((link) => link.classList.remove('toc-current'));
				const targetLink = document.querySelector(`a[href="#${entry.target.id}"].toc-link`);
				if (targetLink) targetLink.classList.add('toc-current');
			}
		});
	}

	function initTOC() {
		if (observeHeaderTags) {
			observeHeaderTags.disconnect();
		}
		// update this with whatever class wraps the writing content
		wrappingElement = document.querySelector('[data-writing-article]');
		if (wrappingElement === null) {
			return;
		}
		// Get all H1/H2/H3 tags from the post
		allHeaderTags = wrappingElement.querySelectorAll('h1, h2, h3');

		// Intersection Observer Options
		const options: IntersectionObserverInit = {
			root: null,
			rootMargin: '0px 0px -50% 0px',
			threshold: 0
		};

		// Each Intersection Observer runs setCurrent
		observeHeaderTags = new IntersectionObserver(setCurrent, options);
		allHeaderTags.forEach((tag) => {
			// add scroll margin so jumped-to headings don't hug the viewport top
			tag.classList.add('scroll-mt-8');
			observeHeaderTags.observe(tag);
		});
	}

	// runs on initial page load
	initTOC();
	// runs on view transitions navigation
	document.addEventListener('astro:after-swap', initTOC);
</script>
