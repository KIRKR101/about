---
const pathname = Astro.url.pathname;
function isActive(path: string) {
	if (path === '/') return pathname === '/';
	return pathname.startsWith(path);
}
function isChildActive(paths: string[]) {
	return paths.some((p) => isActive(p));
}
const collectionPaths = ['/films', '/books', '/art', '/photography'];
const collectionsActive = isChildActive(collectionPaths);
---

<nav aria-label="Main navigation" class="sticky top-0 z-50 h-16 shrink-0 bg-bg/80 backdrop-blur-sm" data-navbar>
	<div class="mx-auto h-full max-w-[1200px] px-4 md:px-6">
		<div class="flex h-full items-center justify-between">
			<div class="flex items-center">
				<a href="/" class="group focus:outline-none">
					<span class="font-serif text-[24px] leading-none tracking-[-1px] text-ink md:text-[28px]">
						<span class="opacity-90">kirkr</span><span class="opacity-40">.xyz</span>
					</span>
				</a>
			</div>

			<nav class="hidden h-full items-center gap-6 md:flex" aria-label="Desktop navigation">
				<a
					href="/writings"
					class:list={[
						'font-sans text-[11px] tracking-[0.1em] uppercase transition-colors duration-75',
						isActive('/writings') ? 'text-ink-80' : 'text-ink-70 hover:text-ink',
					]}>Writings</a
				>
				<a
					href="/projects"
					class:list={[
						'font-sans text-[11px] tracking-[0.1em] uppercase transition-colors duration-75',
						isActive('/projects') ? 'text-ink-80' : 'text-ink-70 hover:text-ink',
					]}>Projects</a
				>
				<div class="relative" data-dropdown="desktop">
					<button
						type="button"
						data-dropdown-trigger="desktop"
						aria-expanded="false"
						aria-haspopup="menu"
						class:list={[
							'flex cursor-pointer items-center gap-1 font-sans text-[11px] tracking-[0.1em] uppercase transition-colors duration-75',
							collectionsActive ? 'text-ink-80' : 'text-ink-70 hover:text-ink',
						]}
					>
						Collections
						<svg
							class="h-3 w-3 transition-transform duration-150"
							data-dropdown-chevron="desktop"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
						</svg>
					</button>
					<div
						role="menu"
						data-dropdown-menu="desktop"
						class="absolute top-full left-1/2 hidden -translate-x-1/2 pt-2"
					>
						<div class="flex flex-col rounded-sm border border-bd bg-bg shadow-xl">
							{
								[
									{ name: 'Films', path: '/films' },
									{ name: 'Books', path: '/books' },
									{ name: 'Art', path: '/art' },
									{ name: 'Photography', path: '/photography' },
								].map((child) => (
									<a
										href={child.path}
										role="menuitem"
										data-dropdown-item
										class:list={[
											'block px-4 py-2 font-sans text-[11px] tracking-[0.1em] whitespace-nowrap uppercase transition-colors duration-75',
											isActive(child.path)
												? 'text-ink-80'
												: 'text-ink-70 hover:bg-ink/5 hover:text-ink',
										]}
									>
										{child.name}
									</a>
								))
							}
						</div>
					</div>
				</div>
			</nav>

			<div class="flex items-center md:hidden">
				<button
					type="button"
					data-menu-toggle
					class="flex h-10 w-10 items-center justify-center"
					aria-label="Open menu"
					aria-expanded="false"
				>
					<svg
						class="h-6 w-6 text-ink-70"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="1.5"
						data-menu-icon-open
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
					</svg>
					<svg
						class="hidden h-6 w-6 text-ink-70"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="1.5"
						data-menu-icon-close
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>

	<div
		data-mobile-menu
		class="absolute top-16 right-0 left-0 hidden rounded-b-sm border-b border-bd bg-bg shadow-xl md:hidden"
	>
		<div class="flex flex-col">
			<a
				href="/writings"
				data-mobile-link
				class:list={[
					'block border-b border-bd/50 px-6 py-3 font-sans text-[11px] tracking-[0.1em] uppercase transition-colors duration-75',
					isActive('/writings')
						? 'bg-ink/5 text-ink-80'
						: 'text-ink-70 hover:bg-ink/5 hover:text-ink',
				]}>Writings</a
			>
			<a
				href="/projects"
				data-mobile-link
				class:list={[
					'block border-b border-bd/50 px-6 py-3 font-sans text-[11px] tracking-[0.1em] uppercase transition-colors duration-75',
					isActive('/projects')
						? 'bg-ink/5 text-ink-80'
						: 'text-ink-70 hover:bg-ink/5 hover:text-ink',
				]}>Projects</a
			>
			<div data-dropdown="mobile">
				<button
					type="button"
					data-dropdown-trigger="mobile"
					aria-expanded="false"
					aria-haspopup="menu"
					class:list={[
						'flex w-full items-center justify-between border-b border-bd/50 px-6 py-3 font-sans text-[11px] tracking-[0.1em] uppercase transition-colors duration-75',
						collectionsActive ? 'text-ink-80' : 'text-ink-70 hover:bg-ink/5 hover:text-ink',
					]}
				>
					Collections
					<svg
						class="h-3 w-3 transition-transform duration-150"
						data-dropdown-chevron="mobile"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
					</svg>
				</button>
				<div role="menu" data-dropdown-menu="mobile" class="hidden flex-col">
					{
						[
							{ name: 'Films', path: '/films' },
							{ name: 'Books', path: '/books' },
							{ name: 'Art', path: '/art' },
							{ name: 'Photography', path: '/photography' },
						].map((child) => (
							<a
								href={child.path}
								role="menuitem"
								data-mobile-link
								class:list={[
									'block border-b border-bd/50 py-2.5 pr-6 pl-10 font-sans text-[11px] tracking-[0.1em] uppercase transition-colors duration-75',
									isActive(child.path)
										? 'text-ink-80'
										: 'text-ink-70 hover:bg-ink/5 hover:text-ink',
								]}
							>
								{child.name}
							</a>
						))
					}
				</div>
			</div>
		</div>
	</div>
</nav>
<div
	data-menu-backdrop
	class="fixed inset-0 top-16 z-40 hidden backdrop-blur-[2px] md:hidden"
	role="button"
	tabindex="0"
	aria-label="Close menu"
>
</div>

<script>
	function initNavbar() {
		const navbar = document.querySelector('[data-navbar]');
		if (!navbar) return;

		const menuToggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
		const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
		const backdrop = document.querySelector('[data-menu-backdrop]') as HTMLElement | null;
		const iconOpen = document.querySelector('[data-menu-icon-open]') as HTMLElement | null;
		const iconClose = document.querySelector('[data-menu-icon-close]') as HTMLElement | null;

		let menuOpen = false;

		function setMenu(open: boolean) {
			menuOpen = open;
			if (mobileMenu) mobileMenu.classList.toggle('hidden', !open);
			if (backdrop) backdrop.classList.toggle('hidden', !open);
			if (iconOpen) iconOpen.classList.toggle('hidden', open);
			if (iconClose) iconClose.classList.toggle('hidden', !open);
			if (menuToggle) {
				menuToggle.setAttribute('aria-expanded', String(open));
				menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			}
			document.documentElement.style.overflow = open ? 'hidden' : '';
		}

		menuToggle?.addEventListener('click', () => setMenu(!menuOpen));
		backdrop?.addEventListener('click', () => setMenu(false));
		backdrop?.addEventListener('keydown', (e: KeyboardEvent) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				setMenu(false);
			}
		});
		document.querySelectorAll('[data-mobile-link]').forEach((el) => {
			el.addEventListener('click', () => setMenu(false));
		});
		document.addEventListener('keydown', (e: KeyboardEvent) => {
			if (e.key === 'Escape' && menuOpen) setMenu(false);
		});

		// Dropdowns (desktop + mobile)
		const dropdowns = new Map<string, boolean>();
		document.querySelectorAll('[data-dropdown-trigger]').forEach((btn) => {
			const key = (btn as HTMLElement).dataset['dropdownTrigger']!;
			dropdowns.set(key, false);
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const isOpen = dropdowns.get(key) ?? false;
				// close all
				dropdowns.forEach((_, k) => dropdowns.set(k, false));
				dropdowns.set(key, !isOpen);
				syncDropdowns();
			});
		});

		function syncDropdowns() {
			dropdowns.forEach((open, key) => {
				const menu = document.querySelector(`[data-dropdown-menu="${key}"]`) as HTMLElement | null;
				const chevron = document.querySelector(
					`[data-dropdown-chevron="${key}"]`,
				) as HTMLElement | null;
				const trigger = document.querySelector(
					`[data-dropdown-trigger="${key}"]`,
				) as HTMLElement | null;
				if (menu) {
					menu.classList.toggle('hidden', !open);
					if (open) menu.classList.remove('hidden');
					// desktop menu needs flex display when open; mobile is flex-col
					if (open && key === 'desktop') menu.classList.add('block');
				}
				if (chevron) chevron.style.transform = open ? 'rotate(180deg)' : '';
				if (trigger) trigger.setAttribute('aria-expanded', String(open));
			});
		}

		// Close dropdowns when clicking outside
		document.addEventListener('click', (e) => {
			const target = e.target as Element;
			if (!target.closest('[data-dropdown]')) {
				let changed = false;
				dropdowns.forEach((open, k) => {
					if (open) {
						dropdowns.set(k, false);
						changed = true;
					}
				});
				if (changed) syncDropdowns();
			}
		});

		// Keyboard navigation for dropdown items
		document.querySelectorAll('[data-dropdown]').forEach((dd) => {
			const trigger = dd.querySelector('[data-dropdown-trigger]') as HTMLElement | null;
			const items = Array.from(dd.querySelectorAll('[data-dropdown-item]')) as HTMLElement[];
			trigger?.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.key === 'ArrowDown') {
					const key = (trigger as HTMLElement).dataset['dropdownTrigger']!;
					if (!dropdowns.get(key)) {
						e.preventDefault();
						dropdowns.set(key, true);
						syncDropdowns();
						requestAnimationFrame(() => items[0]?.focus());
					}
				}
			});
			items.forEach((item, i) => {
				item.addEventListener('keydown', (e: KeyboardEvent) => {
					if (e.key === 'ArrowDown') {
						e.preventDefault();
						items[i + 1]?.focus();
					} else if (e.key === 'ArrowUp') {
						e.preventDefault();
						if (i === 0) {
							const key = (trigger as HTMLElement)?.dataset['dropdownTrigger'];
							if (key) {
								dropdowns.set(key, false);
								syncDropdowns();
							}
							trigger?.focus();
						} else {
							items[i - 1]?.focus();
						}
					} else if (e.key === 'Escape') {
						e.preventDefault();
						const key = (trigger as HTMLElement)?.dataset['dropdownTrigger'];
						if (key) {
							dropdowns.set(key, false);
							syncDropdowns();
						}
						trigger?.focus();
					}
				});
			});
		});

		// Close mobile menu when not open -> reset dropdowns
		const observer = new MutationObserver(() => {
			if (mobileMenu?.classList.contains('hidden')) {
				// keep desktop dropdown state, only reset mobile? simplest: close mobile dropdown when menu closes
				if (dropdowns.get('mobile')) {
					dropdowns.set('mobile', false);
					syncDropdowns();
				}
			}
		});
		if (mobileMenu) observer.observe(mobileMenu, { attributes: true, attributeFilter: ['class'] });
	}

	initNavbar();
	document.addEventListener('astro:after-swap', initNavbar);
</script>
