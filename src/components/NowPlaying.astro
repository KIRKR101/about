---
// Now-playing widget. The markup is intentionally static; src/scripts/now-playing.ts
// fills it from the same-origin /api/now-playing route (Spotify, with a Last.fm
// fallback). Kept as a component so it can be dropped onto other pages without
// duplicating the data hooks.
---

<span aria-label="Now playing" data-now-playing data-state="loading">
	<span data-track-skeleton aria-hidden="true">I am currently listening to music…</span>
	<span data-track-content class="hidden" aria-live="polite" aria-atomic="true">
		<span data-track-status-text>I am currently listening to</span>
		{' '}
		<span data-track-hover-trigger class="group relative cursor-help">
			<span data-track-title>Loading…</span>{' '}by{' '}<span data-track-artist>—</span>
			<span
				role="tooltip"
				data-track-tooltip
				class="pointer-events-none invisible fixed top-0 left-0 z-50 w-[min(18rem,calc(100vw-2rem))] rounded-sm border border-bd bg-card-bg p-3 text-ink-80 opacity-0 shadow-lg transition-opacity duration-150 group-hover:visible group-hover:opacity-100"
			>
				<span class="flex items-center gap-3">
					<img
						data-hover-cover
						alt=""
						class="h-12 w-12 shrink-0 rounded-sm bg-ink/5 object-cover"
					/>
					<span class="min-w-0 flex-1">
						<span data-hover-title class="block truncate font-sans text-[13px] text-ink-90"
							>Loading…</span
						>
						<span data-hover-artist class="mt-0.5 block truncate font-sans text-[11px] text-ink-70"
							>—</span
						>
					</span>
				</span>
				<span
					data-hover-progress-wrap
					class="mt-2 hidden items-center gap-2 font-mono text-[9px] text-ink-50 tabular-nums"
				>
					<span data-hover-current>0:00</span>
					<span class="relative h-[3px] flex-1 overflow-hidden rounded-full bg-rail">
						<span
							data-hover-bar
							class="absolute inset-y-0 left-0 w-full origin-left rounded-full bg-prog"></span>
					</span>
					<span data-hover-total>0:00</span>
				</span>
			</span>
		</span>
	</span>
</span>

<script>
	import '../scripts/now-playing';
</script>
